# Server Configuration
NODE_ENV=development
PORT=5000
APP_NAME=Skillverse

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skillverse?retryWrites=true&w=majority
MONGODB_LOCAL=mongodb://localhost:27017/skillverse
DB_NAME=skillverse

# Authentication & Security
JWT_SECRET=your_extremely_secure_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_key
JWT_REFRESH_EXPIRE=7d
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
CORS_CREDENTIALS=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@skillverse.com
EMAIL_FROM_NAME=Skillverse

# External APIs
JSEARCH_API_KEY=your_jsearch_api_key
LEETCODE_API_URL=https://leetcode.com/graphql
GITHUB_API_TOKEN=your_github_token
GOOGLE_OAUTH_CLIENT_ID=your_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# File Storage (S3/Cloud)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=skillverse-uploads
CLOUDFRONT_URL=https://d123.cloudfront.net

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Feature Flags
FEATURE_REELS_ENABLED=false
FEATURE_LIVE_CLASSES_ENABLED=false
FEATURE_GAMIFICATION_ENABLED=false
FEATURE_AI_RECOMMENDATIONS_ENABLED=false

# Monitoring & Analytics
SENTRY_DSN=
AMPLITUDE_API_KEY=
MIXPANEL_TOKEN=

# Payment Gateway
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin Configuration
ADMIN_EMAIL=admin@skillverse.com
ADMIN_PASSWORD=change_this_securely
