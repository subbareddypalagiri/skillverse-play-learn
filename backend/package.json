{
  "name": "skillverse-backend",
  "version": "2.0.0",
  "description": "Production-ready EdTech + Coding Platform backend with scalable architecture",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "seed:all": "node seeds/seedAll.js",
    "seed:reels": "node seeds/seedReels.js --force",
    "seed:complete": "node runSeeds.js",
    "seed:massive": "node seeds/seedMassiveData.js",
    "seed:users": "node seeds/seedUsers.js",
    "seed:courses": "node seeds/seedCourses.js",
    "seed:problems": "node seeds/seedProblems.js",
    "seed:jobs": "node seeds/seedJobs.js",
    "seed:events": "node seeds/seedEvents.js",
    "create:indexes": "node utils/createIndexes.js",
    "migrate": "node utils/migrations.js",
    "cache:clear": "node utils/clearCache.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "api",
    "education",
    "competitive-programming",
    "job-portal",
    "saas"
  ],
  "author": "Skillverse Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.10",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.5",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
