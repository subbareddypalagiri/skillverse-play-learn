# Copy this file to .env.local and add your actual API keys
# DO NOT commit .env file to git

# ============================================================
# API Configuration
# ============================================================
# Local Development
VITE_API_URL=http://localhost:5000

# Production (Update with your Railway backend URL after deployment)
# VITE_API_URL=https://your-railway-backend.railway.app

# ============================================================
# Supabase Configuration (if used)
# ============================================================
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="your_supabase_url"

# ============================================================
# Third-party API Keys
# ============================================================
# Events API Keys
# Get your free Ticketmaster API key from: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
VITE_TICKETMASTER_API_KEY="your_ticketmaster_api_key"

# Career Hub - Real Internships API
# Get your FREE RapidAPI key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# FREE tier: 2500 requests/month - Provides REAL internships from Indeed, LinkedIn, Glassdoor
VITE_RAPIDAPI_KEY="your_rapidapi_key"

# AI Chatbot - Google Gemini API
# Get your FREE API key from: https://makersuite.google.com/app/apikey
# FREE tier: 60 requests per minute
VITE_GEMINI_API_KEY="your_gemini_api_key"

# OpenAI API (optional)
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY="your_openai_api_key"
