# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/skillverse

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# RapidAPI Configuration (for JSearch Job API)
# 1. Get a FREE API key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# 2. Sign up at RapidAPI (free tier gives 2500 requests/month)
# 3. Copy your API key here
RAPIDAPI_KEY=your_rapidapi_key_here

# Email Configuration (for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Gemini API (if using)
GEMINI_API_KEY=your_gemini_api_key_here
